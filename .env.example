# ============================================================
# AI OPPORTUNITY OS — ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# ── App ─────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME="AI Opportunity OS"

# ── Auth ────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-very-long-random-secret-at-least-64-chars
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Database ────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=opportunity_os
POSTGRES_USER=opportunity_user
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgresql+asyncpg://opportunity_user:change-me-strong-password@localhost:5432/opportunity_os

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Object Storage (MinIO / S3) ─────────────────────────────
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=opportunity-os
STORAGE_USE_SSL=false

# ── AI Provider ─────────────────────────────────────────────
# Primary: Google Gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-pro

# Fallback / Alternative (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# AI Feature flags
AI_EXTRACTION_ENABLED=true
AI_MATCHING_ENABLED=true
AI_SCORING_ENABLED=true
AI_STUB_MODE=true   # Set false when AI keys are configured

# ── Demo Mode ───────────────────────────────────────────────
DEMO_MODE_ENABLED=true
DEMO_USER_EMAIL=demo@opportunityos.com
DEMO_USER_PASSWORD=demo-password-change-me

# ── Security ────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ── Email (optional for Phase 1) ────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@opportunityos.com

# ── Admin ───────────────────────────────────────────────────
ADMIN_EMAIL=admin@opportunityos.com
ADMIN_SECRET_KEY=change-me-admin-secret

# ── Logging ─────────────────────────────────────────────────
LOG_LEVEL=INFO
